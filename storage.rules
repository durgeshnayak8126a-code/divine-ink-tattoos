rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidGalleryImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /admin-avatars/{userId}/{fileName} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    match /gallery/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryImage();
      allow delete: if isAdmin();
    }

    match /before-after/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryImage();
      allow delete: if isAdmin();
    }

    match /featured/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
